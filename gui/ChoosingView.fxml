<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="gui.We_Start_the_Game"
            style="-fx-background-color: linear-gradient(to bottom, #141e30, #243b55);">

    <top>
        <Label text="CHOOSE YOUR SIDE"
               BorderPane.alignment="CENTER"
               style="-fx-text-fill:white; -fx-font-size:26px; -fx-padding:20;"/>
    </top>

    <center>
        <HBox spacing="120" alignment="CENTER">

            <!-- MONSTER 1 SECTION -->
            <VBox alignment="CENTER" spacing="10" onMouseClicked="#handleSection1Click" style="-fx-cursor: hand;">
                <Label text="SCARER" style="-fx-text-fill:white; -fx-font-size:16px;"/>
                
                <!-- Hidden RadioButton to track state -->
                <RadioButton fx:id="monster1" visible="false" managed="false"/>

                <ImageView fitWidth="160" fitHeight="160" preserveRatio="true">
                    <image>
                        <Image url="@scarer.jpg"/>
                    </image>
                </ImageView>

                <Circle fx:id="circle1" radius="7" fill="#d3d3d3" stroke="transparent"/>
            </VBox>

            <!-- MONSTER 2 SECTION -->
            <VBox alignment="CENTER" spacing="10" onMouseClicked="#handleSection2Click" style="-fx-cursor: hand;">
                <Label text="LAUGHER" style="-fx-text-fill:white; -fx-font-size:16px;"/>

                <!-- Hidden RadioButton to track state -->
                <RadioButton fx:id="monster2" visible="false" managed="false"/>
                
                <ImageView fitWidth="160" fitHeight="160" preserveRatio="true">
                    <image>
                        <Image url="@laugher.jpg"/>
                    </image>
                </ImageView>

                <Circle fx:id="circle2" radius="7" fill="#d3d3d3" stroke="transparent"/>
            </VBox>

        </HBox>

    </center>

<bottom>
    <!-- We use -fx-padding here instead of the <padding> tag -->
    
    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20;">

        <Label fx:id="warningLabel"
               text=""
               textFill="RED"
               visible="false"/>

        <Button text="Continue"
                prefWidth="180"
                prefHeight="40"
                style="-fx-background-color:#4CAF50; 
                       -fx-text-fill:white; 
                       -fx-font-size:14px; 
                       -fx-background-radius:15;"
                onAction="#startGame"/>

    </VBox>

</bottom>


</BorderPane>



